# GLDN PR Recall meeting bot. Copy to .env and fill in real values.
# Never commit .env. This workspace is us-west-2 only.

# Region. Must be us-west-2. The process prints this on startup.
RECALL_REGION=us-west-2

# REST API key from https://us-west-2.recall.ai/dashboard/developers/api-keys
# Paste the key itself. Do not add a "Token " prefix.
RECALL_API_KEY=

# Workspace verification secret (starts with whsec_).
# Developers → API Keys & Secrets → Create Workspace Secret.
# Aliases also accepted: RECALL_WEBHOOK_SECRET, RECALL_WORKSPACE_VERIFICATION_SECRET.
# Do not set a per-endpoint Svix secret.
RECALL_WEBHOOK_VERIFICATION_SECRET=

# Stable public backend origin. No trailing slash. Not localhost or an IP.
# Production example: https://notetaker.gldnpr.com
# Local example: https://gldn-notetaker.ngrok.app
PUBLIC_API_BASE_URL=

# Postgres 16 connection string.
DATABASE_URL=postgresql://gldn:gldn@localhost:5432/gldn_recall

# Signs the login cookie. Use a long random string.
SESSION_SECRET=

# Optional. Defaults to PUBLIC_API_BASE_URL when the UI is served by this process.
APP_BASE_URL=

PORT=3000
BOT_NAME=GLDN PR Notetaker

# webpage (default) streams /bot-camera as the bot camera and uses the web_4_core variant.
# image sends the static JPEG and stays on Recall's default bot variant.
BOT_CAMERA_MODE=webpage

# Google Calendar + Google sign-in. Both must be set together.
# Redirect URI must be https://<PUBLIC_API_BASE_URL host>/api/calendar/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Optional shared password so @gldnpr.com teammates can sign in before Google sign-in is verified.
# Leave blank to disable the password form.
APP_SHARED_PASSWORD=
